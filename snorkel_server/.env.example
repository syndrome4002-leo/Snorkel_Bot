# Copy to .env and fill in.

PORT=8787

# Shared secret for the API, the dashboard and the extension's WebSocket.
# Empty disables auth entirely — only acceptable when the server is reachable
# from nothing but localhost. REQUIRED before exposing it to a network.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BOT_TOKEN=

# Bad-token throttle. After AUTH_MAX_FAILURES wrong tokens from one address the
# server returns 429 for AUTH_LOCKOUT_SECONDS — including for the right token,
# which is the point: validating first would give an attacker unlimited guesses.
AUTH_MAX_FAILURES=10
AUTH_LOCKOUT_SECONDS=300

# Set to 1 when the server sits behind a tunnel or reverse proxy (Cloudflare
# Tunnel, nginx, ngrok), so the throttle sees real client IPs instead of
# treating every caller as 127.0.0.1.
TRUST_PROXY=0

# How long POST /api/start waits for the extension to finish the whole flow (ms).
COMMAND_TIMEOUT_MS=240000

# Where Chrome saves downloads. The server reads the task zip from here to
# upload it, and deletes it afterwards — so the server must run on the same
# machine as the browser. Defaults to ~/Downloads.
# DOWNLOADS_DIR=/home/you/Downloads

# ----------------------------------------------------------------- Dropbox --
# The server uploads over HTTPS; there is no browser involved.
#
# Put the app key and secret here, then open
#   http://localhost:8787/api/dropbox/connect
# and approve once. The server stores the refresh token below by itself.
# ("npm run dropbox:auth" does the same from a terminal.)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# Shortcut for a quick try-out: the App Console's "Generate access token" button
# gives you a token you can paste here directly, no OAuth flow needed. It stops
# working after ~4 hours and cannot be renewed, so it is for testing only — an
# unattended bot needs the refresh token above.
DROPBOX_ACCESS_TOKEN=

# Destination folder. Empty = the root of the app folder (or of your Dropbox,
# if you gave the app full access).
DROPBOX_FOLDER=

# ---------------------------------------------------------------- Firebase --
# Set to false to run the server without credentials: task writes are logged
# to the console instead of being sent to Firestore. Useful for a dry run.
FIREBASE_ENABLED=true

# Credentials are resolved in this order:
#
#   1. FIREBASE_SERVICE_ACCOUNT_JSON — the key itself, raw JSON or base64, on one
#      line. Use this on hosts where you cannot ship a file (Docker, Cloud Run,
#      Heroku, CI). Nothing machine-specific ends up in this file.
#   2. FIREBASE_SERVICE_ACCOUNT — a path to the key file. RELATIVE PATHS RESOLVE
#      FROM THE snorkel_server/ FOLDER, not the working directory, so it is portable.
#      Defaults to serviceAccount.json when unset.
#   3. Application Default Credentials (gcloud auth application-default login,
#      or the metadata server on GCE / Cloud Run).
#
# Get the key from Firebase console -> Project settings -> Service accounts ->
# Generate new private key.

# FIREBASE_SERVICE_ACCOUNT=serviceAccount.json
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional; taken from the key file when omitted.
FIREBASE_PROJECT_ID=

# Firestore collection name.
FIREBASE_COLLECTION=Tasks

# How long before a task that already has feedback is opened again to look for
# a newer round. Lower catches a re-review sooner; higher means fewer page
# visits. Unchanged feedback is never stored twice, so re-reading is cheap in
# data terms — only in time.
RECOLLECT_AFTER_MINUTES=60

# Realtime Database URL — the channel the dashboard uses to reach this server,
# so the server needs no inbound connectivity at all. Create the database in
# Firebase console -> Realtime Database; the URL is shown there. Empty turns
# the channel off. Mind the region: europe-west1 / asia-southeast1 use a
# different hostname from the default us-central1 one.
FIREBASE_DATABASE_URL=

# Which deployment this server belongs to.
#
# One Firebase project can carry several independent set-ups. They share a
# database, but not a master switch — turning one off would otherwise stop the
# other. Must match NEXT_PUBLIC_WORKSPACE in its dashboard and WORKSPACE in its
# worker.
WORKSPACE=default
