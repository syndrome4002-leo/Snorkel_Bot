{
  "name": "snorkel-bot-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Commands the Snorkel Bot browser extension and stores the returned task info in Firebase Firestore.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "seed": "node scripts/seed-sample.mjs",
    "seed:delete": "node scripts/seed-sample.mjs --delete",
    "dropbox:auth": "node scripts/dropbox-auth.mjs",
    "backfill:new-task": "node scripts/backfill-is-new-task.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^12.7.0",
    "ws": "^8.18.0"
  }
}
