# Copy to .env.local and fill in from
#   Firebase console -> Project settings -> General -> Your apps -> Web app
#
# These are NOT secrets — every Firebase web app ships them to the browser.
# The dashboard has no login, so the security rules allow unauthenticated
# access: anyone with these values can read your tasks and queue a task.
# Deploy database.rules.json and firestore.rules anyway — a database left in
# "test mode" starts denying everything after 30 days.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=snorkel-fe3eb.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=snorkel-fe3eb
NEXT_PUBLIC_FIREBASE_APP_ID=

# Realtime Database URL, shown in the console once the database exists.
# Note the region: europe-west1 and asia-southeast1 use a different hostname
# from the default us-central1 one.
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://snorkel-fe3eb-default-rtdb.firebaseio.com

# Only if you changed FIREBASE_COLLECTION on the server.
# NEXT_PUBLIC_FIREBASE_COLLECTION=Tasks
