{
  "//": [
    "The shape of the `answers` field in Firestore, and the keys Claude is asked",
    "to produce. Edit here and both change together: the extraction prompt is",
    "generated from this file, so a key added here is asked for and stored",
    "without touching any code.",
    "",
    "`enum` restricts a value; `list: true` means an array of the enum values.",
    "`question` is the number in prompts/build.txt, so a key can be traced back",
    "to what was actually asked."
  ],

  "validity_required": {
    "question": "1",
    "enum": ["fixable", "invalid", "valid-as-is"]
  },

  "duplicate": {
    "question": "2",
    "enum": ["fixable", "invalid/Not Fixable", "Valid-as-is"]
  },

  "where_task_had_issues": {
    "question": "3.1.1",
    "list": true,
    "enum": ["instructions", "tests", "oracle", "environment/dockerfile"],
    "when": "validity_required is fixable"
  },

  "what_issues_found": {
    "question": "3.1.2",
    "list": true,
    "enum": [
      "every requirement in the instructions is not properly tested",
      "all test requirements are not properly specified in the instructions",
      "the instructions appear LLM generated",
      "the instructions are overly-prescriptive",
      "the task leaks solution information",
      "the oracle does not implement the solution following the instructions",
      "less than 10 fail-to-pass tests in test suite"
    ],
    "when": "validity_required is fixable"
  },

  "issues_in_detail": {
    "question": "3.1.3",
    "text": true,
    "when": "validity_required is fixable"
  },

  "files_changed": {
    "question": "3.1.4",
    "text": true,
    "when": "validity_required is fixable"
  },

  "added_PR_explain": {
    "question": "3.1.5",
    "text": true,
    "when": "validity_required is fixable, NA if the PR was not touched"
  },

  "rewrite_time_min": {
    "question": "3.1.6",
    "number": true,
    "when": "validity_required is fixable"
  },

  "invalid_issues": {
    "question": "3.2.1",
    "list": true,
    "enum": ["PR scope needs to be changed or reduced", "environment issues"],
    "when": "validity_required is invalid"
  },

  "invalid_environment_issues": {
    "question": "3.2.2",
    "list": true,
    "enum": [
      "image/dependency build failures",
      "oracle timeout",
      "external-network dependency at build/solve time",
      "dirty git history"
    ],
    "when": "validity_required is invalid and environment issues was selected"
  },

  "invalid_explain": {
    "question": "3.3.3",
    "text": true,
    "when": "validity_required is invalid"
  },

  "what_makes_difficult": {
    "question": "4",
    "text": true
  },

  "senior_estimated_time": {
    "question": "5",
    "enum": ["<10 minutes", "10-20 minutes", "20-40 minutes", "40+ minutes"]
  },

  "review_time_min": {
    "question": "6",
    "number": true
  },

  "submission_time_min": {
    "question": "7",
    "number": true
  }
}
