# Copy to .env and fill in.
#
# Most of this is the same as snorkel_server/.env — the two processes talk to the
# same Firebase project and the same Dropbox app. Copying the Firebase and
# Dropbox blocks straight across is the intended way to set this up.

# ------------------------------------------------------------- folders ------
# Where zips are downloaded and task folders live. Same folder the browser
# downloads into, so the extension's download and the worker's download land in
# the same place. Defaults to ~/Downloads.
# WORK_DIR=/home/you/Downloads

# Also searched, read-only, when looking for an existing task folder. A task
# needing revision is worked in place and never downloaded, so this is how the
# worker finds folders that were unpacked somewhere else. Comma-separated.
# EXTRA_TASK_DIRS=/home/you/Music/sentinel_ultra/tasks

# The reference documents handed to Claude in the first turn of every session.
# Unset means no documents are attached and Claude works from the task alone.
DOCS_DIR=/home/goran/Music/sentinel_ultra/docs

# Which files from DOCS_DIR to attach, in order. Empty = every .txt/.md/.json/
# .toml/.yaml in there, sorted by name.
# DOC_FILES=guidelines.txt,tasking_guide.txt,the_harbor_framework.txt

# ------------------------------------------------------------- worker -------
# How many tasks Claude may work on at once. The dashboard's "Max tasks at once"
# setting overrides this while the worker is running; this is the value used
# before the dashboard has ever been opened.
MAX_CONCURRENT=3

# How often Firestore is checked for work, in seconds.
POLL_SECONDS=30

# Give up on a single task after this long, so one stuck run cannot hold a slot
# forever. Covers the whole session, not one turn.
TASK_TIMEOUT_MINUTES=90

# Pick up tasks a reviewer sent back ("needs revision"). Off for now: only new
# tasks are worked, from download through the platform's own checks. Nothing
# about revisions has been removed, so this is the only change needed to resume.
HANDLE_REVISIONS=false

# Ignore the dashboard's machine list and take every task, whoever it belongs to.
# A debugging switch, not a normal setting: the list is how you say what this
# worker is for. With it off and no machines added, the worker sits idle and says
# so.
ANY_MACHINE=false

# ------------------------------------------------------- connect page -------
# A small local page that hosts the Dropbox handshake and shows what the worker
# can see. Not an API — the worker takes no commands over HTTP.
#
#   http://localhost:8788/                     status
#   http://localhost:8788/api/dropbox/connect  start the handshake
#
# Register this redirect URI on the app's Settings page in the Dropbox App
# Console, or Dropbox will refuse:
#   http://localhost:8788/api/dropbox/callback
CONNECT_ENABLED=true
CONNECT_PORT=8788

# Loopback by default — a page that rewrites credentials should not be on the
# network. Change only if you must reach it from another machine.
CONNECT_HOST=127.0.0.1

# ------------------------------------------------------------- Claude -------
# The Claude Code executable. On PATH by default.
# CLAUDE_BIN=claude

# Empty = whatever the CLI is configured to use.
# CLAUDE_MODEL=opus

# An unattended run cannot answer a permission prompt, and a task needs to run
# its own tests — so anything short of bypassPermissions eventually hangs waiting
# for a keypress nobody is there to give. Narrow it to acceptEdits if you would
# rather a run fail than have the agent execute commands unsupervised.
CLAUDE_PERMISSION_MODE=bypassPermissions

# Extra CLI arguments, space separated. Escape hatch for anything not above.
# CLAUDE_ARGS=--verbose

# Prompt templates. Editing prompts/*.txt needs no restart.
# PROMPTS_DIR=prompts

# ------------------------------------------------------------ Dropbox -------
# The same app snorkel_server uses. Copy the key and secret across verbatim.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# Leave this empty. Start the worker and open
#   http://localhost:8788/api/dropbox/connect
# The callback writes the token back into this file and starts using it straight
# away. Each process needs its own — do not copy the server's.
DROPBOX_REFRESH_TOKEN=

# Testing only: an App Console token, good for about four hours, not renewable.
DROPBOX_ACCESS_TOKEN=

# Must match snorkel_server's DROPBOX_FOLDER, or the worker will look for task
# zips in the wrong place.
DROPBOX_FOLDER=

# ----------------------------------------------------------- Firebase -------
FIREBASE_ENABLED=true

# Credentials resolve in this order:
#   1. FIREBASE_SERVICE_ACCOUNT_JSON — the key itself, raw JSON or base64.
#   2. FIREBASE_SERVICE_ACCOUNT — a path. RELATIVE PATHS RESOLVE FROM
#      snorkel_worker/, not the working directory. Defaults to serviceAccount.json.
#   3. Application Default Credentials.
#
# The same key snorkel_server uses. It is git-ignored in both folders, so it does
# not travel with a clone — copy it across by hand.
# FIREBASE_SERVICE_ACCOUNT=serviceAccount.json
# FIREBASE_SERVICE_ACCOUNT_JSON=

FIREBASE_PROJECT_ID=
FIREBASE_COLLECTION=Tasks

# Realtime Database URL. Without it the worker still works, but its logs stay on
# the console instead of reaching the dashboard.
FIREBASE_DATABASE_URL=
