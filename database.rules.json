{
  "//": [
    "Realtime Database rules for the dashboard <-> server channel.",
    "",
    "Deploy with:  firebase deploy --only database",
    "or paste into Firebase console -> Realtime Database -> Rules.",
    "",
    "The dashboard has no sign-in, so these rules allow unauthenticated access.",
    "Anyone who knows this database URL can therefore read the command history",
    "and queue a task. That is the accepted trade-off for a login-free dashboard.",
    "",
    "The server uses the Admin SDK, which bypasses rules entirely — these only",
    "constrain browsers.",
    "",
    "Two things are still locked down, because they are correctness rather than",
    "access control: /server/status is read-only (only the server publishes it),",
    "and a command cannot be rewritten once the server has claimed it, which",
    "would otherwise corrupt a run in progress."
  ],

  "rules": {
    ".read": false,
    ".write": false,

    "commands": {
      ".read": true,

      "$commandId": {
        ".read": true,
        ".write": "!data.exists() || data.child('status').val() == 'pending'",

        ".validate": "newData.hasChildren(['type', 'status', 'requested_at'])",

        "type": { ".validate": "newData.val() == 'start_new_task' || newData.val() == 'mark_sent' || newData.val() == 'check_revisions'" },
        "status": {
          ".validate": "newData.val() == 'pending' || newData.val() == 'running' || newData.val() == 'succeeded' || newData.val() == 'failed' || newData.val() == 'expired'"
        },
        "requested_at": { ".validate": "newData.isString()" },
        "$other": { ".validate": true }
      }
    },

    "server": {
      "//": "Published by the server; browsers only read it.",
      ".read": true,
      ".write": false
    },

    "task_logs": {
      "//": [
        "One log stream per task UID, written by both snorkel_server and",
        "snorkel_worker so a task's history reads as one sequence even though",
        "two processes on two machines produced it. Browsers only read it."
      ],
      ".read": true,
      ".write": false
    },

    "machines_index": {
      "//": [
        "The machines being worked, added from the dashboard.",
        "",
        "Read by snorkel_worker to decide whose tasks to pick up, so it is",
        "shared rather than per-browser. Removing an entry stops the worker",
        "taking that machine's tasks."
      ],
      ".read": true,
      ".write": true,
      "$machineId": {
        ".validate": "newData.hasChild('added_at') || !newData.exists()",
        "added_at": { ".validate": "newData.isString()" },
        "$other": { ".validate": true }
      }
    },

    "machines": {
      "$machineId": {
        "commands": {
          ".read": true,
          "$commandId": {
            ".write": "!data.exists() || data.child('status').val() == 'pending'",
            ".validate": "newData.hasChildren(['type', 'status', 'requested_at'])",
            "type": {
              ".validate": "newData.val() == 'start_new_task' || newData.val() == 'mark_sent' || newData.val() == 'check_revisions'"
            },
            "status": {
              ".validate": "newData.val() == 'pending' || newData.val() == 'running' || newData.val() == 'succeeded' || newData.val() == 'failed' || newData.val() == 'expired'"
            },
            "requested_at": { ".validate": "newData.isString()" },
            "$other": { ".validate": true }
          }
        },

        "status": {
          "//": "Published by the server.",
          ".read": true,
          ".write": false
        },

        "settings": {
          "//": "Written from the dashboard, read by the server.",
          ".read": true,
          ".write": true,
          "revise_limit": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)" },
          "try_new_task_every_min": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 1)" },
          "check_revise_every_min": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 1)" },
          "submit_check_every_min": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 1)" },
          "worker_max_concurrent": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 1)" },
          "$other": { ".validate": true }
        },

        "logs": {
          "//": "Written by the server only; the dashboard reads the tail.",
          ".read": true,
          ".write": false
        },

        "ticker": {
          "//": "One line, overwritten in place — the countdown to the next check.",
          ".read": true,
          ".write": false
        },

        "worker": {
          "//": "Published by snorkel_worker: how many tasks Claude has open.",
          ".read": true,
          ".write": false
        }
      }
    }
  }
}
